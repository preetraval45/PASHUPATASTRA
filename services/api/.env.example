# Copy to .env for local development. Never commit .env — it is gitignored.
# On AWS these come from Secrets Manager via IRSA, not from a file.

PASHU_ENVIRONMENT=dev

# Dry-run is the default and live execution is opt-in per environment.
# Do not set this to false outside a disposable environment.
PASHU_DRY_RUN=true

PASHU_DATABASE_URL=postgresql://pashupatastra:pashupatastra@localhost:5433/pashupatastra
PASHU_REDIS_URL=redis://localhost:6379/0
PASHU_OPENSEARCH_URL=http://localhost:9200
PASHU_PROMETHEUS_URL=http://localhost:9090

PASHU_AWS_REGION=us-east-1
# Credentials are NOT set here. Use `aws configure sso` or an instance/IRSA role.

# --- AI Gateway --------------------------------------------------------------
# `echo` is the deterministic stub: no credentials, no spend, and it invents
# nothing. Switch to `bedrock` (the production target) or `anthropic` once a
# credential is available. This is the only place the provider is chosen — no
# engine imports a model SDK (CLAUDE.md rule 5).
PASHU_MODEL_PROVIDER=echo

# Named without a provider prefix; Bedrock's `anthropic.` prefix is applied by
# that provider, so switching providers does not require editing this.
PASHU_MODEL_ID=claude-opus-5

# Per-incident token ceiling, enforced before each call. Leave unset to disable.
PASHU_MODEL_TOKEN_CEILING=200000

# Model credentials are NOT set here either:
#   bedrock   — IRSA / SSO, same as every other AWS call
#   anthropic — ANTHROPIC_API_KEY in the environment, or an `ant auth login` profile
