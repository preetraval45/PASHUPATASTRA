<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The page's dark ground (#0b0d11), so opening the app never flashes white. -->
    <color name="ground">#0B0D11</color>

    <!-- Material 3 for the native bars, sheet and buttons. Edge to edge: the bars are drawn
         by the app (MainActivity pads for the status and navigation bars). -->
    <style name="Theme.Pashupatastra" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#2FA3A0</item>
        <item name="colorOnPrimary">#0B0D11</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="TextAppearance.Pashupatastra.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.Pashupatastra.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Pashupatastra</item>
    </style>
</resources>
