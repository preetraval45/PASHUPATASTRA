<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The page's dark ground (#0b0d11), so opening the app never flashes white. -->
    <color name="ground">#0B0D11</color>

    <style name="Theme.Pashupatastra" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Pashupatastra.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Pashupatastra</item>
    </style>
</resources>
