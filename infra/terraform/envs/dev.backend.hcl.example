# Copy to dev.backend.hcl and fill in. The bucket and lock table must exist
# before `terraform init` — they hold the state that creates everything else.
#
#   aws s3api create-bucket --bucket <bucket> --region us-east-1
#   aws dynamodb create-table --table-name pashupatastra-tf-lock \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH --billing-mode PAY_PER_REQUEST

bucket         = "pashupatastra-tfstate-<account-id>"
key            = "dev/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "pashupatastra-tf-lock"
encrypt        = true
